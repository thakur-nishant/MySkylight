# Copy to /etc/myskylight.env and set real values.
NODE_ENV=production
PORT=3001

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Public origin, used for Google Calendar OAuth callbacks and CORS.
SERVER_ORIGIN=https://myskylight.duckdns.org
CORS_ORIGIN=https://myskylight.duckdns.org

# Temporary password for invited members. Change this before inviting anyone.
DEFAULT_MEMBER_PASSWORD=replace-with-a-strong-temporary-password

# Set to false after your household has been created. The app currently keeps
# tasks/projects global, so one server should host one household.
ALLOW_REGISTRATION=true

# Demo data is seeded only in development by default. Leave unset in production.
# SEED_DEMO=false

# Optional Google Calendar integration.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
